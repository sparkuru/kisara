enabled = false
allowed_users = ["123456789"]

# Quote a merged forward or file message and send 保存, setu, or /setu for a prompt.
confirm_timeout_seconds = 60
# Quote the bot prompt to save. The first word is shown; later words are aliases.
confirm_words = ["保存"]
# Quote a merged forward or file message with one of these words to save directly.
direct_confirm_words = ["直接保存"]

# date_original: YYYY-MM-DD/original-name; timestamp_hash: timestamp-sha256.ext
# Archive files keep original names in either mode. Different-content name
# conflicts add _timestamp before the full extension, e.g. name_timestamp.tar.gz.
# Images, videos, audio, and other files retain their existing naming rules.
save_mode = "date_original"
save_root = "/app/setu"

# K, M, and G use 1024-based units.
max_file_bytes = "100M"
max_batch_bytes = "1G"
max_depth = 5
max_nodes = 500

# Read-only NapCat cache mount, needed for forwarded videos with local paths.
local_media_root = "/app/.config/QQ"

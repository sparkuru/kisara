# Deployment / shared services
# Examples: onebot ; telegram ; onebot,telegram ; telegram,music ; official
# Choose only one of onebot / onebot-dev for the same QQ login directory.
COMPOSE_PROFILES=onebot
# Optional internal music provider; each engine configures its own API URL below.
KISARA_MUSIC_IMAGE=moefurina/ncm-api:latest

# OneBot / NapCatQQ
ONEBOT_INSTANCE_ID=personal
# Comma-separated QQ user IDs, e.g. 123456789,987654321.
ONEBOT_ALLOWED_USERS=
# Canonical ordinary feature names; comma-separated. Empty keeps strict allowlists.
ONEBOT_PUBLIC_FEATURE=
# Administrators must also be in ONEBOT_ALLOWED_USERS.
ONEBOT_ADMIN_USERS=
ONEBOT_GROUPS_ENABLED=false
ONEBOT_ALLOWED_GROUPS=
ONEBOT_WS_URL=ws://napcat:3001
# Generate with: openssl rand -hex 32
ONEBOT_ACCESS_TOKEN=replace-with-a-secret
ONEBOT_PING_ENABLED=true
ONEBOT_HELP_ENABLED=true
ONEBOT_NEWS_ENABLED=true
ONEBOT_NEWS_PUSH_ENABLED=true
ONEBOT_MUSIC_ENABLED=true
ONEBOT_MUSIC_API_URL=
# Push recipients must be in the matching allowlists; groups must be enabled.
ONEBOT_NEWS_PUSH_USERS=
ONEBOT_NEWS_PUSH_GROUPS=
ONEBOT_NEWS_PUSH_TIME=10:30
# Positive integer seconds between scheduled-news retries; TOML overrides this.
ONEBOT_NEWS_PUSH_RETRY_SECONDS=60
# Advanced QQ feature settings: config/onebot/features/<name>/config.toml.
# Explicit TOML values override environment values, including false/empty lists.

NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
NAPCAT_HOSTNAME=kisara-qq
NAPCAT_MAC_ADDRESS=02:42:0a:a0:d0:02
# Optional QQ quick-login account; preserve existing login/environment identity.
NAPCAT_ACCOUNT=
NAPCAT_WEBUI_BIND=127.0.0.1
NAPCAT_WEBUI_PORT=6099
NAPCAT_WEBUI_TOKEN=
NAPCAT_UID=
NAPCAT_GID=
# OneBot development hot reload and optional archive ownership override.
ONEBOT_WATCH_INTERVAL=0.5
# ONEBOT_SETU_GID=<output of id -g>; helpers default to the host primary group.

# Telegram: config/telegram/features; separate token, IDs and state.
TELEGRAM_BOT_TOKEN=
# Cloud default. Enable local mode and set the internal root URL for /tgsetu.
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_LOCAL_MODE=false
# Local Bot API only: obtain your own API ID/hash at https://my.telegram.org.
# These credentials are passed only to telegram-bot-api, never to the bot.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# TELEGRAM_TGSETU_GID=<output of id -g>; helpers default to host primary group.
# Opt-in private receive/send summaries: allowed IDs and bounded message previews.
TELEGRAM_MESSAGE_LOG_ENABLED=false
TELEGRAM_INSTANCE_ID=telegram
# Positive numeric Telegram user IDs; independent from QQ user IDs.
TELEGRAM_ALLOWED_USERS=
# Unset defaults to tguid; explicit empty disables public access. Groups still need enablement.
TELEGRAM_PUBLIC_FEATURE=tguid
TELEGRAM_ADMIN_USERS=
TELEGRAM_GROUPS_ENABLED=false
# Negative chat IDs (-100... for supergroups); non-public commands also need user access.
TELEGRAM_ALLOWED_GROUPS=
TELEGRAM_PING_ENABLED=true
TELEGRAM_HELP_ENABLED=true
TELEGRAM_NEWS_ENABLED=true
TELEGRAM_NEWS_PUSH_ENABLED=true
TELEGRAM_MUSIC_ENABLED=true
TELEGRAM_MUSIC_API_URL=
TELEGRAM_NEWS_PUSH_USERS=
TELEGRAM_NEWS_PUSH_GROUPS=
TELEGRAM_NEWS_PUSH_TIME=10:30
# Positive integer seconds; longer Telegram retry-after still wins.
TELEGRAM_NEWS_PUSH_RETRY_SECONDS=60

# Tencent Official: config/official/features; independent credentials and IDs.
OFFICIAL_APP_ID=replace-with-app-id
OFFICIAL_APP_SECRET=replace-with-app-secret
OFFICIAL_INSTANCE_ID=official
OFFICIAL_ALLOWED_USERS=
OFFICIAL_PUBLIC_FEATURE=
OFFICIAL_GROUPS_ENABLED=false
OFFICIAL_ALLOWED_GROUPS=
OFFICIAL_PING_ENABLED=true
OFFICIAL_HELP_ENABLED=true
OFFICIAL_NEWS_ENABLED=true
OFFICIAL_MUSIC_ENABLED=true
OFFICIAL_MUSIC_API_URL=
# Scheduled news push is unsupported by the Official engine.

# KISARA_ENGINE selects direct runtime only; preview follows COMPOSE_PROFILES.
# Example: ./kisara.sh preview start official
# All entrypoints load config/<engine>/features/<name>/config.toml.
# The default group configuration is config/<engine>/groups.json.
# Compose maps each engine's settings to its own runtime KISARA_* variables.
# Old OneBot KISARA_* and Official AppID/AppSecret names are compatible fallbacks
# only when the corresponding new name is absent; an explicit new empty value wins.

# Preview lifecycle: ./kisara.sh preview start|status|build|down (down preserves data).
# Start prepares missing resources; true blocks automatic pull/build/install.
KISARA_PREVIEW_OFFLINE=false
# Bounded startup readiness (seconds); actual login/network must become ready.
KISARA_PREVIEW_TIMEOUT=90
# Optional image namespace for preview Compose bot images (empty = project-preview).
KISARA_PREVIEW_IMAGE_PREFIX=
# Remote Docker wildcard publishing only: comma-separated daemon-host addresses.
# Obtain them on that host; caller-machine addresses are never substituted.
KISARA_PREVIEW_HOST_ADDRESSES=
# Optional offline hako development runtime image, with Python 3.12.
HAKO_IMAGE=python:3.12-slim

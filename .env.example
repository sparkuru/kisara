# common
KISARA_ENGINE=onebot
KISARA_INSTANCE_ID=personal
## users that allows bot to serve, example: 123456789,987654321
KISARA_ALLOWED_USERS=
## allowed users with group administration privileges for Kisara commands
KISARA_ADMIN_USERS=
## groups that allows bot to serve
KISARA_GROUPS_ENABLED=false
KISARA_ALLOWED_GROUPS=
# Configure chat, tarot, news, source, music, love, and setu in
# config/features/<name>/config.toml (copy each config.toml.example first).
# Optional comma-separated personal news recipients, all in KISARA_ALLOWED_USERS.
# news.push_users in TOML takes precedence, including an explicit empty list.
KISARA_NEWS_PUSH_USERS=

# Optional music service image for the Compose music profile
KISARA_MUSIC_IMAGE=moefurina/ncm-api:latest
# If running Compose directly on a host whose group ID is not 1000, set:
# KISARA_SETU_GID=<output of id -g>

# OneBot 11 / NapCatQQ
ONEBOT_WS_URL=ws://napcat:3001
## generate one with: openssl rand -hex 32
ONEBOT_ACCESS_TOKEN=replace-with-a-secret

# OneBot Compose deployment
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
NAPCAT_HOSTNAME=kisara-qq
NAPCAT_MAC_ADDRESS=02:42:0a:a0:d0:02
# fast login
NAPCAT_ACCOUNT=
NAPCAT_WEBUI_BIND=127.0.0.1
NAPCAT_WEBUI_PORT=6099
NAPCAT_WEBUI_TOKEN=
NAPCAT_UID=
NAPCAT_GID=

# OneBot development hot reload
KISARA_WATCH_INTERVAL=0.5

# Tencent Official bot engine
AppID=replace-with-app-id
AppSecret=replace-with-app-secret

# Compose engine selection; music adds optional internal provider infrastructure.
# Examples: onebot ; telegram ; onebot,telegram ; telegram,music ; official
COMPOSE_PROFILES=onebot

# Telegram: independent IDs, feature config (config/telegram/features), and state.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INSTANCE_ID=telegram
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ADMIN_USERS=
TELEGRAM_GROUPS_ENABLED=false
# Negative chat IDs (including -100... supergroups); callers also need user access.
TELEGRAM_ALLOWED_GROUPS=
TELEGRAM_PING_ENABLED=true
TELEGRAM_HELP_ENABLED=true
TELEGRAM_NEWS_ENABLED=true
TELEGRAM_NEWS_PUSH_ENABLED=true
TELEGRAM_MUSIC_ENABLED=true
TELEGRAM_MUSIC_API_URL=
TELEGRAM_NEWS_PUSH_USERS=
TELEGRAM_NEWS_PUSH_GROUPS=
TELEGRAM_NEWS_PUSH_TIME=10:30

# Official Compose access is independent from OneBot; preview official remains available.
OFFICIAL_INSTANCE_ID=official
OFFICIAL_ALLOWED_USERS=
OFFICIAL_GROUPS_ENABLED=false
OFFICIAL_ALLOWED_GROUPS=
OFFICIAL_MUSIC_API_URL=

# common
KISARA_ENGINE=onebot
KISARA_INSTANCE_ID=personal
## users that allows bot to serve, example: 123456789,987654321
KISARA_ALLOWED_USERS=
## allowed users with group administration privileges for Kisara commands
KISARA_ADMIN_USERS=
## groups that allows bot to serve
KISARA_GROUPS_ENABLED=false
KISARA_ALLOWED_GROUPS=
## optional per-group settings: copy config/groups.example.json to config/groups.json

# Phrasebook chat
KISARA_CHAT_ENABLED=true
KISARA_CHAT_BOT_NAME=Kisara
KISARA_CHAT_SENDER_NAME=you
KISARA_CHAT_LIBRARY=cute
KISARA_CHAT_TRIGGER_RATE=30
KISARA_CHAT_SIMILARITY_RATE=60
KISARA_CHAT_IGNORED_PHRASES=
KISARA_CHAT_BANNED_USERS=
KISARA_CHAT_ALWAYS_REPLY_USERS=
KISARA_CHAT_REPLY_TO_MENTIONS=true

# Daily tarot readings
KISARA_TAROT_ENABLED=true
KISARA_TAROT_SPREAD_RATE=5

# Optional provider credentials and local music API
SAUCENAO_API_KEY=
KISARA_MUSIC_API_URL=
KISARA_MUSIC_IMAGE=moefurina/ncm-api:latest
TIANAPI_KEY=

# Automatic daily brief delivery to a subset of allowed groups
KISARA_NEWS_PUSH_GROUPS=
KISARA_NEWS_PUSH_TIME=10:30

# OneBot 11 / NapCatQQ
ONEBOT_WS_URL=ws://napcat:3001
## generate one with: openssl rand -hex 32
ONEBOT_ACCESS_TOKEN=replace-with-a-secret

# OneBot Compose deployment
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
NAPCAT_HOSTNAME=kisara-qq
NAPCAT_MAC_ADDRESS=02:42:0a:a0:d0:02
# fast login
NAPCAT_ACCOUNT=
NAPCAT_WEBUI_BIND=127.0.0.1
NAPCAT_WEBUI_PORT=6099
NAPCAT_WEBUI_TOKEN=
NAPCAT_UID=
NAPCAT_GID=

# OneBot development hot reload
KISARA_WATCH_INTERVAL=0.5

# Tencent Official bot engine
AppID=replace-with-app-id
AppSecret=replace-with-app-secret
